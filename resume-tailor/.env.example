# Resume Tailor - Configuration
# Set OPENAI_API_KEY to enable AI-powered resume rewriting.
# Without it, the app uses a rule-based engine (still functional).

# ── AI Resume Tailoring ─────────────────────────────────
# Any OpenAI-compatible API works (OpenAI, OpenRouter, local LLMs)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Job Search APIs ─────────────────────────────────────
# At least one provider must be configured to enable job search.
# All providers offer free tiers — pick any or all.

# ── Adzuna ──────────────────────────────────────────────
# Sign up: https://developer.adzuna.com/
# Free tier: 250 requests/month
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ── USAJobs ─────────────────────────────────────────────
# Sign up: https://developer.usajobs.gov/APIRequest/Index
# Free tier: unlimited (government data)
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# ── JSearch (RapidAPI) ──────────────────────────────────
# Sign up: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Free tier: 200 requests/month
RAPIDAPI_KEY=
